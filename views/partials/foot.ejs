</main>
<% const _buy = typeof item !== 'undefined' && item ? buyUrlFor(item) : site.buyUrl; %>
<section class="cta" id="buy">
  <div class="wrap cta-inner">
    <div>
      <h2><%= L(site.ctaTitle) %></h2>
      <p><%= L(site.ctaDesc) %></p>
      <% if (site.contact && (site.contact.wechat || site.contact.email)) { %>
      <p class="contact">
        <% if (site.contact.wechat) { %><span><%= t('wechat') %>：<b><%= site.contact.wechat %></b></span><% } %>
        <% if (site.contact.email) { %><span><%= t('email') %>：<a href="mailto:<%= site.contact.email %>"><%= site.contact.email %></a></span><% } %>
      </p>
      <% } %>
    </div>
    <a class="btn btn-buy btn-lg" href="<%= _buy %>" target="_blank" rel="noopener noreferrer sponsored"><%= t('buyNow') %> <span aria-hidden="true">→</span></a>
  </div>
</section>
<footer class="site-footer">
  <div class="wrap">
    <span>© <%= new Date().getFullYear() %> <%= L(site.siteName) %></span>
    <% if (site.icp) { %><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"><%= site.icp %></a><% } %>
  </div>
</footer>
<script src="/static/js/main.js" defer></script>
</body>
</html>
