<%
  const _title = typeof title !== 'undefined' && title ? `${title} · ${L(site.siteName)}` : `${L(site.siteName)} · ${L(site.tagline)}`;
  const _desc = typeof description !== 'undefined' && description ? description : L(site.heroDesc);
  const _img = typeof image !== 'undefined' && image ? image : '';
%><!doctype html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= _title %></title>
  <meta name="description" content="<%= _desc %>">
  <meta name="theme-color" content="#3b5bfd">
  <meta property="og:title" content="<%= _title %>">
  <meta property="og:description" content="<%= _desc %>">
  <% if (_img) { %><meta property="og:image" content="<%= origin %><%= _img %>"><% } %>
  <% if (canonical) { %>
  <link rel="canonical" href="<%= origin %><%= canonical %>">
  <link rel="alternate" hreflang="zh" href="<%= origin %><%= altPaths.zh %>">
  <link rel="alternate" hreflang="en" href="<%= origin %><%= altPaths.en %>">
  <% } %>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%233b5bfd'/%3E%3Cpath d='M13 11l-5 5 5 5M19 11l5 5-5 5' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<a class="skip" href="#main"><%= lang === 'zh' ? '跳到内容' : 'Skip to content' %></a>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/<%= lang %>/"><span class="logo" aria-hidden="true">&lt;/&gt;</span><span><%= L(site.siteName) %></span></a>
    <nav class="nav" aria-label="Sections">
      <% sections.forEach(s => { %>
        <a href="/<%= lang %>/<%= s.id %>" class="<%= (typeof section !== 'undefined' && section && section.id === s.id) ? 'active' : '' %>">
          <%= L(s.title) %><% if (!s.items.length) { %><em class="soon"><%= t('soon') %></em><% } %>
        </a>
      <% }) %>
    </nav>
    <a class="lang" href="<%= switchHref %>" hreflang="<%= other %>" lang="<%= other %>" title="<%= t('language') %>" rel="nofollow">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
      <%= t('switchTo') %>
    </a>
  </div>
</header>
<main id="main">
