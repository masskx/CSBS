<%
  const _title = typeof title !== 'undefined' && title ? `${title} · ${L(site.siteName)}` : `${L(site.siteName)} · ${L(site.tagline)}`;
  const _desc = typeof description !== 'undefined' && description ? description : L(site.heroDesc);
  const _img = typeof image !== 'undefined' && image ? image : '';
%><!doctype html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= _title %></title>
  <meta name="description" content="<%= _desc %>">
  <meta name="theme-color" content="#f4f0e8">
  <meta property="og:title" content="<%= _title %>">
  <meta property="og:description" content="<%= _desc %>">
  <% if (_img) { %><meta property="og:image" content="<%= origin %><%= _img %>"><% } %>
  <% if (canonical) { %>
  <link rel="canonical" href="<%= origin %><%= canonical %>">
  <link rel="alternate" hreflang="zh" href="<%= origin %><%= altPaths.zh %>">
  <link rel="alternate" hreflang="en" href="<%= origin %><%= altPaths.en %>">
  <% } %>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23d9441f'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<a class="skip" href="#main"><%= lang === 'zh' ? '跳到内容' : 'Skip to content' %></a>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/<%= lang %>/"><i aria-hidden="true"></i><%= L(site.siteName) %></a>
    <nav class="nav" aria-label="Sections">
      <% sections.forEach(s => { %>
        <a href="/<%= lang %>/<%= s.id %>" class="<%= (typeof section !== 'undefined' && section && section.id === s.id) ? 'active' : '' %>">
          <%= L(s.title) %><% if (!s.items.length) { %><sup><%= t('soon') %></sup><% } %>
        </a>
      <% }) %>
    </nav>
    <a class="lang" href="<%= switchHref %>" hreflang="<%= other %>" lang="<%= other %>" title="<%= t('language') %>" rel="nofollow"><%= t('switchTo') %></a>
  </div>
</header>
<main id="main">
