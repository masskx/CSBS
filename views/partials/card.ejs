<a class="tile" href="/<%= lang %>/<%= it.section %>/<%= it.slug %>">
  <div class="thumb"><img src="<%= it.coverUrl %>" alt="<%= L(it.title) %>" loading="lazy" width="800" height="600"></div>
  <% const cat = (sec.categories || []).find(c => c.id === it.category); %>
  <p class="tile-meta"><%= cat ? L(cat.label) : '' %><%= it.year ? ' · ' + it.year : '' %></p>
  <h3><%= L(it.title) %></h3>
  <p class="tile-sum"><%= L(it.summary) %></p>
</a>
