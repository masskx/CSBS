<%- include('partials/head') %>
<section class="hero">
  <div class="wrap">
    <h1><%= L(site.heroTitle) %></h1>
    <div class="hero-row">
      <p class="lead"><%= L(site.heroDesc) %></p>
      <div class="actions">
        <a class="btn btn-ink" href="#sec-<%= sections[0].id %>"><%= t('browse') %> ↓</a>
      </div>
    </div>
    <ol class="facts">
      <% site.highlights.forEach(h => { %><li><%= L(h) %></li><% }) %>
    </ol>
  </div>
</section>

<% sections.forEach(sec => { %>
<section class="block" id="sec-<%= sec.id %>">
  <div class="wrap">
    <div class="block-head">
      <h2><%= L(sec.title) %></h2>
      <p class="muted"><%= L(sec.desc) %></p>
      <% if (sec.items.length) { %><a class="more-link" href="/<%= lang %>/<%= sec.id %>"><%= t('count', { n: sec.items.length }) %> →</a><% } %>
    </div>
    <% if (sec.items.length) { %>
      <div class="tiles">
        <% sec.items.slice(0, 9).forEach(it => { %><%- include('partials/card', { it, sec }) %><% }) %>
      </div>
    <% } else { %><%- include('partials/soon') %><% } %>
  </div>
</section>
<% }) %>
<%- include('partials/foot') %>
