<%
  const cat = (section.categories || []).find(c => c.id === item.category);
  const paras = String(L(item.description) || '').split(/\n\s*\n/).filter(Boolean);
  const docs = item.documents || [];
  const feats = L(item.features);
  const buy = buyUrlFor(item);
  const docName = (d) => d.title ? L(d.title) : t('doc.' + d.type);
%>
<%- include('partials/head', { title: L(item.title), description: L(item.summary), image: item.coverUrl }) %>
<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/<%= lang %>/<%= section.id %>">← <%= L(section.title) %></a>
  </nav>

  <header class="p-head">
    <p class="tile-meta"><%= cat ? L(cat.label) : '' %><%= item.year ? ' · ' + item.year : '' %></p>
    <h1><%= L(item.title) %></h1>
    <p class="lead"><%= L(item.summary) %></p>
  </header>

  <div class="p-media">
    <% if (item.videoInfo) { %>
      <div class="video">
        <% if (item.videoInfo.type === 'file') { %>
          <video controls preload="metadata" playsinline poster="<%= item.shots[0] || item.coverUrl %>"><source src="<%= item.videoInfo.src %>"></video>
        <% } else { %>
          <iframe src="<%= item.videoInfo.src %>" title="<%= L(item.title) %>" loading="lazy" allowfullscreen referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"></iframe>
        <% } %>
      </div>
    <% } else { %>
      <img src="<%= item.coverUrl %>" alt="<%= L(item.title) %>" width="800" height="600">
    <% } %>
  </div>

  <div class="detail">
    <article class="detail-main">
      <section class="sec">
        <h2 class="label"><%= t('overview') %></h2>
        <% paras.forEach(p => { %><p class="body"><%= p %></p><% }) %>
      </section>

      <% if (Array.isArray(feats) && feats.length) { %>
      <section class="sec">
        <h2 class="label"><%= t('features') %></h2>
        <ol class="feat"><% feats.forEach(f => { %><li><%= f %></li><% }) %></ol>
      </section>
      <% } %>

      <% if ((item.techStack || []).length) { %>
      <section class="sec">
        <h2 class="label"><%= t('techStack') %></h2>
        <p class="stack"><%= item.techStack.join(' / ') %></p>
      </section>
      <% } %>

      <% if (item.shots.length) { %>
      <section class="sec">
        <h2 class="label"><%= t('screenshots') %></h2>
        <div class="shots">
          <% item.shots.forEach((s, i) => { %>
            <a href="<%= s %>" data-lightbox><img src="<%= s %>" alt="<%= L(item.title) %> – <%= i + 1 %>" loading="lazy" width="800" height="600"></a>
          <% }) %>
        </div>
      </section>
      <% } %>
    </article>

    <aside class="buybox">
      <h2 class="label"><%= t('includedLabel') %></h2>
      <ul class="docs">
        <% docs.forEach(d => { %>
        <li>
          <b><%= docName(d) %></b>
          <small><%= [d.format, d.pages ? t('pages', { n: d.pages }) : '', d.note ? L(d.note) : ''].filter(Boolean).join(' · ') %></small>
        </li>
        <% }) %>
        <% if (item.videoInfo) { %><li><b><%= t('video') %></b></li><% } %>
      </ul>
      <a class="btn btn-buy btn-block" href="<%= buy %>" target="_blank" rel="noopener noreferrer sponsored"><%= t('get') %> →</a>
      <p class="note"><%= L(site.deliveryNote) %></p>
    </aside>
  </div>

  <% if (related.length) { %>
  <section class="sec related">
    <h2 class="label"><%= t('related') %></h2>
    <div class="tiles">
      <% related.forEach(it => { %><%- include('partials/card', { it, sec: section }) %><% }) %>
    </div>
  </section>
  <% } %>
</div>

<div class="sticky-buy">
  <span><%= L(item.title) %></span>
  <a class="btn btn-buy" href="<%= buy %>" target="_blank" rel="noopener noreferrer sponsored"><%= t('getShort') %> →</a>
</div>
<%- include('partials/foot') %>
